# SQLite by default — swap for a Postgres URL in production if you want.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Provider API keys — users supply these in the app sidebar.
# These are optional server-side fallbacks (e.g. for batch jobs).
# GROQ_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# DEEPSEEK_API_KEY=""
# MISTRAL_API_KEY=""
# OMNIRoute_API_KEY=""
# OPENROUTER_API_KEY=""
