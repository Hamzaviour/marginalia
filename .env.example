# SQLite by default — swap for a Postgres URL in production if you want.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Nothing else goes here. Every user supplies their own Groq API key
# from the sidebar in the app itself — it's never stored server-side,
# so this repo has no shared secret to leak.
